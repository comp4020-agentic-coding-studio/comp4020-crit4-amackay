---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// The link-preview card: public/card.png, 1200x630 --- replace it. og:image
// wants an absolute URL, so build it from the configured site and base path
// rather than writing "./card.png", which resolves against whichever page
// names it. No og:title/og:description: scrapers fall back to the title and
// description above.
// BASE_URL is the configured base verbatim, and astro.config.ts writes it
// without a trailing slash --- joining naively yields ".../<repo>card.png".
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const card = new URL(`${base}card.png`, Astro.site);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={card} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <!-- "Request Desktop Site" substitutes its own wide virtual viewport for
         device-width, which a page cannot detect or opt out of. Rewriting the
         meta tag above at runtime turned out not to be enough on its own —
         confirmed on a real Android Chrome phone: the attribute updates but
         the browser never re-derives layout from it, and its own guess at the
         viewport width kept changing after load besides. A `zoom` correction
         on <body> was tried next and overshot badly: `zoom` isn't paint-only
         in Chromium, it can also perturb how descendants' own `vw`/`vmin`
         resolve — exactly the mechanism `.stage` is built on, so the
         correction and the bug compounded instead of cancelling.
         `transform: scale()` doesn't have that problem: it never touches
         layout or viewport-unit resolution, so it's applied here to a
         dedicated wrapper (not <body> itself, so the diagnostic overlay below
         stays unaffected) — counter-scaling by the ratio the browser is about
         to shrink it by via its own zoom-to-fit, net effect 1:1 against the
         real screen. `getBoundingClientRect()`, which the instrument's own
         touch hit-testing already relies on, reports the post-transform box
         for free, so pointer interaction needs no changes. Re-derived on
         every layout change via ResizeObserver rather than a single
         snapshot, since the browser's own guess was seen moving after load,
         not just at it. Every gate fails closed: any doubt and this does
         nothing, since a false positive would break a genuine narrow desktop
         window, which this vmin layout must still support untouched.
         DESIGN.md "Sizing" documents this exception. -->
    <div id="vp-fix-root" style="display: contents;">
      <slot />
    </div>
    <script is:inline>
      (function () {
        var diag = null;
        var root = document.getElementById("vp-fix-root");

        function measure() {
          var isTouch = "ontouchstart" in window || (navigator.maxTouchPoints || 0) > 0;
          var screenW = screen.width;
          var screenH = screen.height;
          var shortAxis = Math.min(screenW, screenH);
          var layoutWidth = document.documentElement.clientWidth || window.innerWidth || 0;
          var applies = isTouch && shortAxis > 0 && shortAxis <= 480 && layoutWidth > shortAxis * 1.5;
          return { isTouch: isTouch, screenW: screenW, screenH: screenH, shortAxis: shortAxis, layoutWidth: layoutWidth, applies: applies };
        }

        function apply() {
          try {
            var m = measure();
            var meta = document.querySelector('meta[name="viewport"]');
            if (m.applies) {
              if (meta) {
                meta.setAttribute(
                  "content",
                  "width=" + m.shortAxis + ", initial-scale=1, maximum-scale=1, user-scalable=no",
                );
              }
              var ratio = Math.min(6, Math.max(1, m.layoutWidth / m.shortAxis));
              root.style.display = "block";
              root.style.transform = "scale(" + ratio + ")";
              m.scale = ratio;
            } else {
              root.style.transform = "";
              root.style.display = "contents";
              m.scale = 1;
            }
            diag = m;
          } catch (e) {
            diag = { error: String(e) };
          }
          if (window.__viewportDebugRender) window.__viewportDebugRender();
        }

        apply();
        if ("ResizeObserver" in window) new ResizeObserver(apply).observe(document.documentElement);
        window.addEventListener("load", apply);

        // Temporary: investigating a real-device report of the correction
        // overshooting/undershooting. Remove once confirmed fixed.
        // ?debugviewport prints live values so a screenshot beats guessing.
        if (new URLSearchParams(location.search).has("debugviewport")) {
          var box;
          window.__viewportDebugRender = function () {
            if (!box) {
              box = document.createElement("pre");
              box.style.cssText =
                "position:fixed;top:0;left:0;z-index:99999;background:#000;color:#0f0;" +
                "font:12px monospace;padding:8px;margin:0;white-space:pre-wrap;max-width:100vw;";
              document.body.appendChild(box);
            }
            var meta = document.querySelector('meta[name="viewport"]');
            box.textContent = [
              "isTouch: " + (diag && diag.isTouch),
              "screen: " + (diag && diag.screenW) + "x" + (diag && diag.screenH),
              "shortAxis: " + (diag && diag.shortAxis),
              "layoutWidth (live): " + (diag && diag.layoutWidth),
              "applies: " + (diag && diag.applies),
              "wrapper scale: " + (diag && diag.scale),
              "innerWidth: " + window.innerWidth,
              "clientWidth: " + document.documentElement.clientWidth,
              "meta content: " + (meta && meta.getAttribute("content")),
              diag && diag.error ? "error: " + diag.error : "",
            ]
              .filter(Boolean)
              .join("\n");
          };
          window.__viewportDebugRender();
        }
      })();
    </script>
  </body>
</html>
