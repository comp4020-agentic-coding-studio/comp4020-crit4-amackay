---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// The link-preview card: public/card.png, 1200x630 --- replace it. og:image
// wants an absolute URL, so build it from the configured site and base path
// rather than writing "./card.png", which resolves against whichever page
// names it. No og:title/og:description: scrapers fall back to the title and
// description above.
// BASE_URL is the configured base verbatim, and astro.config.ts writes it
// without a trailing slash --- joining naively yields ".../<repo>card.png".
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const card = new URL(`${base}card.png`, Astro.site);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={card} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <!-- "Request Desktop Site" hands the page a substituted layout viewport,
         which it has no API to detect or opt out of, and whose height does not
         describe the screen: measured on a real Android Chrome phone, `vmin`
         resolved against ~590px while the visible area was 1831 layout px
         tall. The whole fit (DESIGN.md "Sizing") derives from `100vmin`, so
         the stage came out miniaturized with dead background below it — the
         latter because `body`'s `height: 100%` is that same wrong height.

         `visualViewport` describes what is genuinely on screen whatever the
         layout viewport claims, so take both the size and the box from it: an
         explicit `--twelfth` overriding the `100vmin` one, and this wrapper
         pinned to the visible rect so the stage centres on it. `display:
         contents` is the untouched default on every ordinary visit, where the
         two viewports agree and this does nothing.

         The listeners are load-bearing, not belt-and-braces: at parse time
         that same phone still reported the ordinary 443x828 viewport and only
         switched afterwards, so a load-time-only check measures the wrong
         state and concludes there is nothing to fix. -->
    <div id="vp-fix-root" style="display: contents;">
      <slot />
    </div>
    <script is:inline>
      (function () {
        var root = document.getElementById("vp-fix-root");
        var stage = document.querySelector("[data-instrument]");
        var lastTwelfth = null;
        var applied = false;
        var busy = false;

        // Gate on the physical screen: hardware, and the one thing a browser
        // mode cannot restyle. A genuine narrow desktop window has no touch
        // and a large screen, so it never matches and never gets touched.
        function anomalous() {
          var isTouch = "ontouchstart" in window || (navigator.maxTouchPoints || 0) > 0;
          var shortAxis = Math.min(screen.width, screen.height);
          return (
            isTouch &&
            shortAxis > 0 &&
            shortAxis <= 480 &&
            document.documentElement.clientWidth > shortAxis * 1.5
          );
        }

        // FIT_SIZE lives in index.astro and reaches the DOM as --fit-size; read
        // it back rather than restating the constant here.
        function fitSize() {
          var n = stage ? parseFloat(getComputedStyle(stage).getPropertyValue("--fit-size")) : NaN;
          return n > 0 ? n : 15;
        }

        function apply() {
          if (busy) return; // resizing in here re-enters through our own listeners
          busy = true;
          try {
            var v = window.visualViewport;
            if (v && stage && anomalous()) {
              var t = Math.min(v.width, v.height) / fitSize();
              // Threshold, so sub-pixel jitter cannot ping-pong with those
              // same listeners.
              if (lastTwelfth === null || Math.abs(t - lastTwelfth) > 0.25) {
                lastTwelfth = t;
                stage.style.setProperty("--twelfth", t + "px");
              }
              root.setAttribute(
                "style",
                "position:fixed;display:grid;place-items:center;place-content:center;" +
                  "overflow:hidden;left:" + v.offsetLeft + "px;top:" + v.offsetTop + "px;" +
                  "width:" + v.width + "px;height:" + v.height + "px;",
              );
              applied = true;
            } else if (applied) {
              stage.style.removeProperty("--twelfth");
              root.setAttribute("style", "display: contents;");
              lastTwelfth = null;
              applied = false;
            }
          } catch (e) {
            // A viewport quirk must never be what stops the instrument loading.
          }
          busy = false;
        }

        apply();
        window.addEventListener("resize", apply);
        window.addEventListener("orientationchange", apply);
        window.addEventListener("load", apply);
        if (window.visualViewport) window.visualViewport.addEventListener("resize", apply);
      })();
    </script>
  </body>
</html>
