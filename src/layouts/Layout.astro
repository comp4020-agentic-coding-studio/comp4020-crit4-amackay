---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// The link-preview card: public/card.png, 1200x630 --- replace it. og:image
// wants an absolute URL, so build it from the configured site and base path
// rather than writing "./card.png", which resolves against whichever page
// names it. No og:title/og:description: scrapers fall back to the title and
// description above.
// BASE_URL is the configured base verbatim, and astro.config.ts writes it
// without a trailing slash --- joining naively yields ".../<repo>card.png".
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const card = new URL(`${base}card.png`, Astro.site);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={card} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <!-- "Request Desktop Site" substitutes its own virtual layout viewport for
         device-width, which a page cannot detect or opt out of. On a portrait
         phone that substituted viewport is landscape-shaped, so `100vmin`
         picks its bogus *height* as the short axis and the whole fit (DESIGN.md
         "Sizing") is derived from a number that has nothing to do with the
         screen. The symptom is a miniaturized stage with dead background below
         it, because `body`'s `height: 100%` is that same wrong height.

         It is a wrong-axis bug, not a wrong-scale one, which is why three
         uniform multipliers failed before this: rewriting the meta tag (the
         attribute updates, the browser never re-derives layout from it),
         `zoom` on <body> (not paint-only in Chromium — it perturbs how
         descendants' own vw/vmin resolve, i.e. the very mechanism being
         corrected), and `transform: scale()` on a wrapper. Each only traded
         "too small" for "too big".

         So derive the size from `visualViewport` instead, which reports what
         is actually on screen regardless of what the layout viewport claims,
         and pin the wrapper to it so the stage centres on the visible area
         rather than on the phantom one. A no-op in normal browsing, where the
         two viewports agree. -->
    <div id="vp-fix-root" style="display: contents;">
      <slot />
    </div>
    <script is:inline>
      (function () {
        var root = document.getElementById("vp-fix-root");
        var stage = document.querySelector("[data-instrument]");
        var params = new URLSearchParams(location.search);
        var off = params.get("vpfix") === "off";
        var forced = params.get("vpfix") === "vv";
        var baseline = null;
        var lastTwelfth = null;
        var busy = false;
        var diag = {};

        function metrics() {
          var v = window.visualViewport;
          var d = document.documentElement;
          return {
            screenW: screen.width,
            screenH: screen.height,
            dpr: window.devicePixelRatio,
            innerW: window.innerWidth,
            innerH: window.innerHeight,
            clientW: d.clientWidth,
            clientH: d.clientHeight,
            vvW: v ? Math.round(v.width) : null,
            vvH: v ? Math.round(v.height) : null,
            vvScale: v ? Math.round(v.scale * 1000) / 1000 : null,
            vvLeft: v ? Math.round(v.offsetLeft) : null,
            vvTop: v ? Math.round(v.offsetTop) : null,
          };
        }

        // The layout viewport is untrustworthy on a phone that has been handed
        // a desktop-shaped one. Gate on the physical screen, which is hardware
        // and cannot be restyled by a browser mode, so a genuine narrow desktop
        // window (large screen, no touch) can never match.
        function anomalous(m) {
          var isTouch = "ontouchstart" in window || (navigator.maxTouchPoints || 0) > 0;
          var shortAxis = Math.min(m.screenW, m.screenH);
          return isTouch && shortAxis > 0 && shortAxis <= 480 && m.clientW > shortAxis * 1.5;
        }

        // FIT_SIZE lives in index.astro and reaches the DOM as --fit-size; read
        // it rather than restating the constant here.
        function fitSize() {
          var n = stage ? parseFloat(getComputedStyle(stage).getPropertyValue("--fit-size")) : NaN;
          return n > 0 ? n : 15;
        }

        function apply() {
          if (busy) return; // resizing in here can re-enter through our own listeners
          busy = true;
          try {
            var m = metrics();
            if (!baseline) baseline = m;
            var v = window.visualViewport;
            var on = !off && !!v && !!stage && (forced || anomalous(m));
            diag = { m: m, on: on, anomalous: anomalous(m) };
            if (on) {
              var t = Math.min(v.width, v.height) / fitSize();
              // Threshold, so sub-pixel jitter can't ping-pong with the
              // resize listeners that brought us here.
              if (lastTwelfth === null || Math.abs(t - lastTwelfth) > 0.25) {
                lastTwelfth = t;
                stage.style.setProperty("--twelfth", t + "px");
              }
              root.setAttribute(
                "style",
                "position:fixed;display:grid;place-items:center;place-content:center;" +
                  "overflow:hidden;left:" + v.offsetLeft + "px;top:" + v.offsetTop + "px;" +
                  "width:" + v.width + "px;height:" + v.height + "px;",
              );
              diag.twelfth = Math.round(t * 100) / 100;
            }
          } catch (e) {
            diag.error = String(e);
          }
          busy = false;
          if (window.__vpRender) window.__vpRender();
        }

        apply();
        window.addEventListener("resize", apply);
        window.addEventListener("orientationchange", apply);
        window.addEventListener("load", apply);
        if (window.visualViewport) window.visualViewport.addEventListener("resize", apply);

        // Temporary, for diagnosing this on a real device. Remove once the fix
        // is confirmed. ?debugviewport reports the metrics captured before any
        // correction alongside the live ones, and scales its own text by the
        // page's zoom-out factor so it stays readable in a screenshot.
        if (params.has("debugviewport")) {
          var box;
          window.__vpRender = function () {
            if (!box) {
              box = document.createElement("pre");
              box.style.cssText =
                "position:fixed;top:0;left:0;z-index:99999;background:#000;color:#0f0;" +
                "padding:8px;margin:0;white-space:pre;line-height:1.25;";
              document.body.appendChild(box);
            }
            var m = diag.m || {};
            var b = baseline || {};
            var meta = document.querySelector('meta[name="viewport"]');
            box.style.fontSize = Math.max(12, Math.round(13 * ((m.innerW || 1) / (m.screenW || 1)))) + "px";
            box.textContent = [
              "BASELINE (pre-fix)",
              " screen    " + b.screenW + "x" + b.screenH + "  dpr " + b.dpr,
              " client    " + b.clientW + "x" + b.clientH,
              " inner     " + b.innerW + "x" + b.innerH,
              " visualVP  " + b.vvW + "x" + b.vvH + "  scale " + b.vvScale,
              "LIVE",
              " client    " + m.clientW + "x" + m.clientH,
              " inner     " + m.innerW + "x" + m.innerH,
              " visualVP  " + m.vvW + "x" + m.vvH + "  scale " + m.vvScale,
              " vv offset " + m.vvLeft + "," + m.vvTop,
              "FIX",
              " anomalous " + diag.anomalous + "   active " + diag.on,
              " twelfth   " + diag.twelfth + "px  (fit " + fitSize() + ")",
              " meta      " + (meta && meta.getAttribute("content")),
              diag.error ? " error " + diag.error : "",
            ]
              .filter(Boolean)
              .join("\n");
          };
          window.__vpRender();
        }
      })();
    </script>
  </body>
</html>
