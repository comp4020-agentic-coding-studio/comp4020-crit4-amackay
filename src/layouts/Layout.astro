---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// The link-preview card: public/card.png, 1200x630 --- replace it. og:image
// wants an absolute URL, so build it from the configured site and base path
// rather than writing "./card.png", which resolves against whichever page
// names it. No og:title/og:description: scrapers fall back to the title and
// description above.
// BASE_URL is the configured base verbatim, and astro.config.ts writes it
// without a trailing slash --- joining naively yields ".../<repo>card.png".
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const card = new URL(`${base}card.png`, Astro.site);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no" />
    <!-- "Request Desktop Site" substitutes its own wide virtual viewport for
         device-width, which a page cannot detect or opt out of. This corrects
         the meta tag back to the real screen width when that's happened, so
         the vmin-based fit (DESIGN.md "Sizing") isn't zoomed out to fit the
         wrong viewport. Gated to fail closed: any doubt and it does nothing,
         since a false positive would break a genuine narrow desktop window. -->
    <script is:inline>
      (function () {
        var diag = null;
        try {
          var isTouch = "ontouchstart" in window || (navigator.maxTouchPoints || 0) > 0;
          var screenW = screen.width;
          var screenH = screen.height;
          var shortAxis = Math.min(screenW, screenH);
          var layoutWidth = document.documentElement.clientWidth || window.innerWidth || 0;
          var fired = false;
          if (isTouch && shortAxis > 0 && shortAxis <= 480 && layoutWidth > shortAxis * 1.5) {
            var meta = document.querySelector('meta[name="viewport"]');
            if (meta) {
              meta.setAttribute(
                "content",
                "width=" + shortAxis + ", initial-scale=1, maximum-scale=1, user-scalable=no",
              );
              fired = true;
            }
          }
          diag = {
            isTouch: isTouch,
            screenW: screenW,
            screenH: screenH,
            shortAxis: shortAxis,
            layoutWidth: layoutWidth,
            fired: fired,
          };
        } catch (e) {
          diag = { error: String(e) };
        }

        // Temporary: investigating a real-device report that this correction had
        // no visible effect on Android Chrome's "Request Desktop Site". Remove
        // once diagnosed. ?debugviewport prints the raw values so a screenshot
        // can be sent back instead of guessing at real-device behaviour.
        if (new URLSearchParams(location.search).has("debugviewport")) {
          document.addEventListener("DOMContentLoaded", function () {
            var meta = document.querySelector('meta[name="viewport"]');
            var lines = [
              "isTouch: " + (diag && diag.isTouch),
              "screen: " + (diag && diag.screenW) + "x" + (diag && diag.screenH),
              "shortAxis (at load): " + (diag && diag.shortAxis),
              "layoutWidth (at load): " + (diag && diag.layoutWidth),
              "correction fired: " + (diag && diag.fired),
              "innerWidth now: " + window.innerWidth,
              "clientWidth now: " + document.documentElement.clientWidth,
              "meta content now: " + (meta && meta.getAttribute("content")),
              diag && diag.error ? "error: " + diag.error : "",
            ];
            var box = document.createElement("pre");
            box.textContent = lines.filter(Boolean).join("\n");
            box.style.cssText =
              "position:fixed;top:0;left:0;z-index:99999;background:#000;color:#0f0;" +
              "font:12px monospace;padding:8px;margin:0;white-space:pre-wrap;max-width:100vw;";
            document.body.appendChild(box);
          });
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={card} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
