---
import Layout from "../layouts/Layout.astro";
import {
  CENTRE_X,
  CENTRE_Y,
  DOMAIN_SIZE,
  EXTENT,
  HEX,
  R,
  drawnCells,
  nodeForCell,
} from "../lib/tonnetz.ts";
import { equalTemperamentNameFor, equalTemperamentRatioFor, hueFor } from "../lib/tuning.ts";

// The drawn window: a square big enough that 1 twelfth = 100vmin/FIT_SIZE
// (see the <style> below) shows FIT_SIZE twelfths on whichever viewport axis
// is shorter and extends the long axis into more of this same pre-drawn
// lattice — the square shape is what makes that work with no portrait special
// case. Its centre, extent and margin are all derived from the fundamental
// domain in tonnetz.ts rather than restated here: the camera and the domain
// moving independently is exactly how the corner ended up a fifth out of
// place once already. DESIGN.md "Sizing".
const [CX, CY] = [CENTRE_X, CENTRE_Y];

const caps = drawnCells();

// The visibility rect: concentric with the fundamental domain, padded on every
// side.
const FIT_PADDING = 1.5;
const FIT_SIZE = DOMAIN_SIZE + 2 * FIT_PADDING;

// y negated throughout so the drawing is upright (lattice y is up, SVG y is
// down) — done once here, per cap, never by transforming the whole group.
const shortKey = (code: string): string => code.replace(/^Key|^Digit/, "");

const renderCaps = caps.map((cap) => {
  const points = HEX.map(([hx, hy]) => `${cap.x + hx},${-(cap.y + hy)}`).join(" ");
  const ratio = equalTemperamentRatioFor(cap.pc);
  const node = nodeForCell(cap.m, cap.n);
  return {
    m: cap.m,
    n: cap.n,
    pc: cap.pc,
    points,
    code: node?.code,
    // Only the fundamental domain's twelve caps are labelled; the rest of the
    // block plays without a hint. DESIGN.md "Keyboard".
    key: node?.hint ? shortKey(node.code) : undefined,
    x: cap.x,
    y: -cap.y,
    hue: hueFor(ratio),
    name: equalTemperamentNameFor(ratio),
  };
});

const viewBox = `${CX - EXTENT} ${-(CY + EXTENT)} ${EXTENT * 2} ${EXTENT * 2}`;

// The same hexagon again, as fractions of its own bounding box, so a cap can
// be clipped to itself and no effect on it can reach a neighbour — DESIGN.md
// "Effects stay inside the cap". Derived from HEX rather than hand-written:
// there is one hexagon in this repo and it is in tonnetz.ts. On this one the
// six vertices still land on exact fractions of the box (x at quarters,
// y at fifths, since the y offsets are now halves), so nothing here rounds.
const screenHex = HEX.map(([hx, hy]): [number, number] => [hx, -hy]);
const clipXs = screenHex.map(([x]) => x);
const clipYs = screenHex.map(([, y]) => y);
const [cx0, cx1] = [Math.min(...clipXs), Math.max(...clipXs)];
const [cy0, cy1] = [Math.min(...clipYs), Math.max(...clipYs)];
const capClip = `polygon(${screenHex
  .map(([x, y]) => `${((x - cx0) / (cx1 - cx0)) * 100}% ${((y - cy0) / (cy1 - cy0)) * 100}%`)
  .join(", ")})`;
---

<Layout
  title="Touch-Tonnetz"
  description="A musical instrument based on the Tonnetz — a repeating layout where nearby notes sound nice together. Playable via touch, mouse, or keyboard."
>
  <header class="visually-hidden">
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <!-- The title plate and the About panel are one element in two states; the
       whole expand is a CSS transition between them, so nothing here is
       duplicated for the open case and the <h1> is the panel's heading as
       well as the plate. DESIGN.md "About panel". -->
  <section class="about" data-about>
    <h1>
      <button type="button" data-about-toggle aria-expanded="false" aria-controls="about-body">
        Touch-Tonnetz
      </button>
    </h1>
    <button type="button" class="about-close" data-about-close aria-label="Close">&#215;</button>
    <div class="about-body" id="about-body">
      <p>
        A musical instrument based on the
        <a href="https://en.wikipedia.org/wiki/Tonnetz" target="_blank" rel="noopener noreferrer">Tonnetz</a>
        — a repeating layout where nearby notes sound nice together.
      </p>
      <p>
        There is no highest note — each note plays a
        <a href="https://en.wikipedia.org/wiki/Shepard_tone" target="_blank" rel="noopener noreferrer">Shepard tone</a>.
      </p>
      <p>Playable via touch, mouse, or keyboard.</p>
    </div>
  </section>
  <div class="about-scrim" data-about-scrim aria-hidden="true"></div>
  <noscript>
    <p class="noscript-plate">Needs JavaScript to play.</p>
  </noscript>
  <main
    data-instrument
    class="stage"
    style={`--press-diameter:${R * 2}; --cap-clip:${capClip}; --fit-size:${FIT_SIZE}`}
  >
    <svg viewBox={viewBox} xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      {
        renderCaps.map((cap) => (
          <g class="cap" data-m={cap.m} data-n={cap.n} data-pc={cap.pc} data-note={cap.code} style={`--hue:${cap.hue}`}>
            <polygon points={cap.points} />
            <text class="name" x={cap.x} y={cap.y}>
              {cap.name}
            </text>
            {cap.key && (
              <text class="key" x={cap.x + 0.9} y={cap.y + 0.9}>
                {cap.key}
              </text>
            )}
          </g>
        ))
      }
    </svg>
    <div class="cursor-dot" data-cursor aria-hidden="true"></div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>

<style>
  /* 1 twelfth = 100vmin/--fit-size: the short viewport axis always shows
     exactly FIT_SIZE twelfths (DESIGN.md "Sizing"), and vmin's continuous
     scaling reveals more of this same pre-drawn square on the long axis with
     no separate portrait case. The body (global.css) centres and clips the
     excess. */
  /* The title sits over the surface rather than in the flow: the stage is a
     square much larger than the viewport and centred in it (see "Sizing"), so
     a second grid row would push the lattice off-centre and change what the
     marked viewports show. Out of flow, it costs the layout nothing.

     Closed, this is the plate; open, it is the About card, and every property
     that differs between the two is animatable — so the title reaches its
     place on the card by the plate growing around it, with no second heading
     and no measurement in script. It stays horizontally centred throughout,
     which is what keeps the whole morph a transition rather than a FLIP.
     DESIGN.md "About panel".

     `width`/`height` interpolate from `fit-content` because global.css sets
     `interpolate-size: allow-keywords`. */
  .about {
    /* The open card's geometry, as constants rather than as state: the copy is
       laid out against these in *both* states, so it is laid out once and the
       growing card only reveals it. Sized against the animating box instead,
       it re-wrapped on every frame of the expand. */
    --card-w: min(34rem, 92vw);
    /* Two numbers describe the whole card: --card-pad is every distance to an
       edge, --card-gap is every distance between two things inside it. The ×
       reads --card-pad for its own inset like everything else, so the top of
       the card is inset exactly as far as the sides are and none of this needs
       balancing against the rest by hand. */
    --card-pad: clamp(1.35rem, 4vmin, 2.4rem);
    --card-gap: clamp(0.8rem, 2.4vmin, 1.6rem);
    --close-size: clamp(2.75rem, 4.6vmin, 3.2rem);
    /* The × hugs the corner rather than sitting on --card-pad: it shares the
       title's row, and anything further in runs into the title's ink. */
    --close-inset: clamp(0.35rem, 1.6vmin, 1.05rem);
    /* Height follows the copy: `about-panel.ts` measures the body once it is
       laid out and writes --card-fit. The fallback is only what shows if that
       never runs; --card-max is what keeps a tall card off a short screen. */
    --card-max: 78dvh;
    --card-h: min(var(--card-fit, 26rem), var(--card-max));
    /* The floor is the phone's, and it is load-bearing: the title is centred
       and `nowrap`, the × is in the corner of the same row, and at 390 the two
       collide as soon as the type goes past about here. Nothing automated
       catches that --- jsdom has no layout --- so it is
       `scripts/probe-about-close.js` that measures the gap. */
    --title-open: clamp(1.75rem, 5.4vmin, 2.8rem);
    --title-leading: var(--plate-leading);
    --title-top: var(--card-pad);
    --copy-top: calc(var(--title-top) + var(--title-open) * var(--title-leading) + var(--card-gap));
    /* The one piece of geometry that *is* state: the title's own size, which
       transitions between the plate's and the card's. */
    --title-size: var(--plate-title-size);
    position: fixed;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    width: fit-content;
    height: fit-content;
    max-width: 92vw;
    /* No padding of its own while closed: the toggle carries it, so the whole
       plate is the click target and not just the glyphs. */
    padding: 0;
    overflow: hidden;
    color: oklch(96% 0.01 260);
    /* Its own backdrop, because it has to stay legible over whichever cap
       happens to be under it, and the caps span a wide lightness range. The
       one part of the UI exempt from "no greys" — DESIGN.md "Visual design". */
    background: oklch(18% 0.01 260 / 0.72);
    border-radius: 0 0 0.5rem 0.5rem;
    /* The plate is a click target now, so only the buttons inside it take the
       pointer while it is closed: the surface keeps everything else. */
    pointer-events: none;
    transition:
      top 320ms cubic-bezier(0.2, 0, 0, 1),
      width 320ms cubic-bezier(0.2, 0, 0, 1),
      height 320ms cubic-bezier(0.2, 0, 0, 1),
      padding 320ms cubic-bezier(0.2, 0, 0, 1),
      border-radius 320ms cubic-bezier(0.2, 0, 0, 1),
      background-color 320ms ease-out;
  }

  .about[data-open] {
    --title-size: var(--title-open);
    top: clamp(0.75rem, 6dvh, 4rem);
    width: var(--card-w);
    height: var(--card-h);
    padding: var(--title-top) var(--card-pad) var(--card-pad);
    border-radius: 0.75rem;
    background: oklch(18% 0.01 260 / 0.94);
    pointer-events: auto;
  }

  .about h1 {
    margin: 0;
    font: 600 var(--title-size) / var(--title-leading) system-ui, sans-serif;
    letter-spacing: 0.09em;
    white-space: nowrap;
    text-align: center;
    transition: font-size 320ms cubic-bezier(0.2, 0, 0, 1);
  }

  /* Tall enough for the copy at the card's width, with a little slack. The
     narrow branch is for the card at 92vw, where the same copy takes half
     again as many lines; the body scrolls if it ever overflows, but at both
     marked viewports it does not. */
  @media (max-width: 34rem) {
    .about {
      --card-max: 82dvh;
    }
  }

  /* The plate is the button: no chrome of its own, the title's own type, and
     the plate's padding — which is what makes the whole plate the click
     target. Open, the card's own padding takes over and this goes to zero. */
  .about h1 button {
    display: block;
    /* A button shrink-wraps even as a block box, so the plate would only be
       as wide as its glyphs without this. */
    width: 100%;
    padding: var(--plate-pad-top) 1.1rem var(--plate-pad-bottom);
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
    pointer-events: auto;
    user-select: none;
    -webkit-user-select: none;
    transition: padding 320ms cubic-bezier(0.2, 0, 0, 1);
  }

  .about[data-open] h1 button {
    padding: 0;
    cursor: default;
  }

  /* global.css's focus ring is black and inset, which is right on a cap and
     invisible on this panel. Same ring, this panel's palette. */
  .about :focus-visible {
    outline: 2px solid oklch(96% 0.01 260);
    outline-offset: 3px;
  }

  /* The toggle is the whole plate, and the plate sits flush against the top
     edge: an outset ring there would be half off-screen. */
  .about h1 button:focus-visible {
    outline-offset: -3px;
  }

  .about-close {
    position: absolute;
    top: var(--close-inset);
    right: var(--close-inset);
    display: grid;
    place-items: center;
    /* --close-size is floored at 2.75rem = 44px, the touch-target size, which
       the phone reads off the floor rather than off the vmin term. */
    width: var(--close-size);
    height: var(--close-size);
    font: 400 clamp(1.8rem, 3vmin, 2.1rem) / 1 system-ui, sans-serif;
    color: inherit;
    background: none;
    border: 0;
    border-radius: 0.4rem;
    cursor: pointer;
    pointer-events: auto;
    opacity: 0;
    /* `visibility` rather than opacity alone: it is what keeps the ×, and the
       body's links, out of the tab order while the panel is closed. */
    visibility: hidden;
    transition:
      opacity 160ms ease-out,
      visibility 0s linear 320ms;
  }

  .about[data-open] .about-close {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 180ms ease-out 260ms,
      visibility 0s;
  }

  /* Out of flow in *both* states, so none of this copy ever reaches the
     plate's `fit-content` size. Letting it join the flow on open was enough to
     break the expand: `fit-content` is resolved at layout, after the
     descendant's new `position` has applied, so the transition's start value
     was the card-sized one and the plate appeared to grow out of a rect far
     bigger than itself.

     The box is the *open* card's copy area in both states, never the animating
     one, so the text is laid out once: while the card is smaller than this the
     panel's `overflow: hidden` simply clips it. That is what stops the copy
     re-wrapping on every frame of the expand — and, with the box never
     starting at zero height, what stops `overflow-y` flashing a scrollbar as
     it grows. */
  .about-body {
    position: absolute;
    left: var(--card-pad);
    top: var(--copy-top);
    width: calc(var(--card-w) - 2 * var(--card-pad));
    /* Its own content's height, which is what --card-fit is measured from;
       the cap only bites when the dvh clamp above has already shortened the
       card, and then this is what scrolls. */
    height: auto;
    max-height: calc(var(--card-max) - var(--copy-top) - var(--card-pad));
    overflow-y: auto;
    font: 400 clamp(1.05rem, 2.6vmin, 1.5rem) / 1.55 system-ui, sans-serif;
    letter-spacing: normal;
    text-align: left;
    user-select: text;
    -webkit-user-select: text;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 160ms ease-out,
      visibility 0s linear 320ms;
  }

  /* Held back until the card has finished growing: laid-out-once copy still
     reads badly arriving through a moving clip edge. Fading out on close needs
     no such delay — the copy is gone before the card starts shrinking. */
  .about[data-open] .about-body {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 180ms ease-out 260ms,
      visibility 0s;
  }

  .about-body p {
    margin: 0 0 0.85em;
  }

  .about-body p:last-child {
    margin-bottom: 0;
  }

  /* global.css's link blue is a light-background colour; this one has to hold
     up on the panel's own dark backdrop. */
  .about-body a {
    color: oklch(80% 0.13 240);
  }

  /* Under the panel, over the surface: a click anywhere off the card closes
     it, and while it is open nothing reaches the caps. */
  .about-scrim {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: rgb(0 0 0 / 0.55);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 320ms ease-out,
      visibility 0s linear 320ms;
  }

  .about-scrim[data-open] {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 320ms ease-out,
      visibility 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .about,
    .about[data-open],
    .about h1,
    .about[data-open] h1,
    .about .about-close,
    .about[data-open] .about-close,
    .about .about-body,
    .about[data-open] .about-body,
    .about-scrim,
    .about-scrim[data-open] {
      transition: none;
    }
  }

  .stage {
    /* Driven by --fit-size (FIT_SIZE above) rather than a hardcoded number,
       so the one constant reaches both the CSS here and Layout.astro's
       viewport correction, which reads it back off this element rather than
       restating it. DESIGN.md "Sizing". */
    --twelfth: calc(100vmin / var(--fit-size));
    position: relative;
    width: calc(var(--twelfth) * 34);
    height: calc(var(--twelfth) * 34);
    touch-action: none;
    /* Crosshair, per instruction: symmetrical, so it sits concentrically
       inside the press-radius ring instead of fighting it. */
    cursor: crosshair;
  }

  .stage svg {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  /* Every cap is clipped to its own hexagon, so nothing drawn on one can reach
     a neighbour and make the paint order visible — DESIGN.md "Effects stay
     inside the cap".

     `fill-box` is not optional. The default reference box for an SVG element
     is `border-box`, which css-masking maps to *stroke*-box, giving a clip
     that sits on the stroke's outer edge and widens with `stroke-width` — it
     parses, changes nothing, and hides that it changes nothing.

     Two placements this must keep: on the `polygon`, never on `.cap` (a <g>'s
     bounding box is the union of its children, labels included, so the
     fractions above would no longer describe the hexagon); and any future
     filter goes here too, since clipping is applied after filtering only for
     the same element. */
  /* Three states across a wide range, per instruction: the surface rests dark
     and dull and blooms as it is played. Lightness and chroma rise together,
     so a state differs in vividness as well as brightness — DESIGN.md
     "Visual design". Resting chroma stays high enough that hue still reads as
     pitch class; below about 0.06 the twelve stop being tellable apart. */
  .cap polygon {
    fill: oklch(64% 0.07 var(--hue));
    stroke: #000;
    stroke-width: 0.09;
    clip-path: var(--cap-clip) fill-box;
    transition: fill 500ms ease-out;
  }

  /* The mouse hover preview: which caps a click would press, DESIGN.md
     "Mouse preview". The same channel the played state uses, a smaller step
     along it — a preview is the played state's quieter cousin, not a
     different kind of mark. Declared before .active, which has equal
     specificity, so a cap that is both (a held key under a hovering mouse)
     reads as played. */
  .cap.hover polygon {
    fill: oklch(76% 0.115 var(--hue));
    transition-duration: 200ms;
  }

  .cap.active polygon {
    fill: oklch(89% 0.175 var(--hue));
    transition-duration: 15ms;
  }

  /* The fat-finger hitbox, drawn for the one input that has no size of its
     own to show it with: a mouse pointer. Diameter is 2r in twelfths
     (--press-diameter, set from tonnetz.ts's R in index.astro) at the same
     px-per-twelfth scale as the caps, so the dot is the true footprint of a
     click, not a decoration sized to taste.

     It rides *around* the real cursor and never replaces it: the page must
     never take the pointer away, so no `cursor: none` anywhere — DESIGN.md
     "The page never owns the cursor". */
  .cursor-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(var(--twelfth) * var(--press-diameter));
    height: calc(var(--twelfth) * var(--press-diameter));
    margin: calc(var(--twelfth) * var(--press-diameter) / -2) 0 0 calc(var(--twelfth) * var(--press-diameter) / -2);
    border-radius: 50%;
    border: 1.5px solid oklch(100% 0 0 / 0.7);
    background: oklch(100% 0 0 / 0.15);
    pointer-events: none;
    opacity: 0;
    transition: opacity 120ms ease-out;
  }

  .cursor-dot.visible {
    opacity: 1;
  }

  .cap .name,
  .cap .key {
    fill: #000;
    text-anchor: middle;
    dominant-baseline: central;
    text-transform: uppercase;
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .cap .name {
    font: 700 1.15px system-ui, sans-serif;
  }

  /* Quieter than the pitch name by size and weight alone: both labels are
     plain black, per instruction, so nothing here reduces opacity to make the
     hint recede — that would composite the cap's hue through it and put a grey
     back on the surface. */
  .cap .key {
    font: 600 0.55px system-ui, sans-serif;
  }

  /* A hint names a key, and on a device with no keyboard it names nothing the
     player can reach. `any-hover` asks about input hardware rather than about
     layout, so a desktop window resized to phone proportions still has its
     mouse and keeps the hints; a phone that turns out to have a keyboard says
     so by using one, which main.ts is watching for. Losing them costs a phone
     nothing it can act on, and the About panel still says the instrument is
     playable by keyboard. */
  @media (any-hover: none) {
    :global(html:not(.has-keyboard)) .cap .key {
      display: none;
    }
  }

  /* Hangs under the title plate, and only exists at all with scripting off —
     the state where the lattice lays out perfectly and then does nothing, by
     far the most convincing way this page can look correct and be broken. Its
     own small plate rather than a second state of `.about`: that element is a
     transition between two shapes, and none of that machinery has anything to
     do with a line of text that never moves. The offset is --plate-h, which
     the plate's own height is built from (global.css). */
  .noscript-plate {
    position: fixed;
    top: calc(var(--plate-h) + 0.5rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    /* Without this the box shrink-wraps against the space left of `left: 50%`
       — half the viewport — and the line wraps on a phone for no reason. */
    width: max-content;
    max-width: 92vw;
    margin: 0;
    padding: var(--plate-pad-top) 1.1rem var(--plate-pad-bottom);
    color: oklch(96% 0.01 260);
    font: 600 clamp(0.9rem, 2.2vmin, 1.1rem) / var(--plate-leading) system-ui, sans-serif;
    letter-spacing: 0.06em;
    text-align: center;
    /* The plate's backdrop, for the plate's reason: it has to stay legible
       over whichever cap happens to be under it. */
    background: oklch(18% 0.01 260 / 0.72);
    border-radius: 0.5rem;
    /* Nothing to click, and the surface keeps the pointer. */
    pointer-events: none;
  }

</style>
