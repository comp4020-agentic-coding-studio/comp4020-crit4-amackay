---
import Layout from "../layouts/Layout.astro";
import { NODES } from "../lib/lattice.ts";

const ROWS = [NODES.slice(0, 10), NODES.slice(10, 20), NODES.slice(20, 30), NODES.slice(30, 40)];
---

<Layout
  title="COMP4020 prototype"
  description="Replace this with one sentence saying what this page is. A search result and a link preview both show it."
>
  <header class="visually-hidden">
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <h1 class="visually-hidden">COMP4020 prototype</h1>
  <main data-instrument class="stage">
    {
      ROWS.map((row) => (
        <div class="row">
          {row.map((node) => (
            <button type="button" class="cap" data-note={node.code} style={`--hue:${node.hue}`}>
              {node.label}
            </button>
          ))}
        </div>
      ))
    }
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
