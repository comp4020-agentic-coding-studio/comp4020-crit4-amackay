---
import Layout from "../layouts/Layout.astro";
import {
  CENTRE_X,
  CENTRE_Y,
  EXTENT,
  FIT_SIZE_INITIAL,
  HEX,
  R,
  WINDOW_SIZE,
  capPaths,
  drawnCells,
  nodeForCell,
} from "../lib/tonnetz.ts";
import { equalTemperamentNameFor, equalTemperamentRatioFor, hueFor } from "../lib/tuning.ts";

// The drawn window: a square big enough that 1 twelfth = 100vmin/FIT_SIZE
// (see the <style> below) shows FIT_SIZE twelfths on whichever viewport axis
// is shorter and extends the long axis into more of this same pre-drawn
// lattice — the square shape is what makes that work with no portrait special
// case. Its centre, extent and margin are all derived from the fundamental
// domain in tonnetz.ts rather than restated here: the camera and the domain
// moving independently is exactly how the corner ended up a fifth out of
// place once already. DESIGN.md "Sizing".
const [CX, CY] = [CENTRE_X, CENTRE_Y];

const caps = drawnCells();

// y negated throughout so the drawing is upright (lattice y is up, SVG y is
// down) — done once here, per cap, never by transforming the whole group.
const shortKey = (code: string): string => code.replace(/^Key|^Digit/, "");

const renderCaps = caps.map((cap) => {
  const points = HEX.map(([hx, hy]) => `${cap.x + hx},${-(cap.y + hy)}`).join(" ");
  const ratio = equalTemperamentRatioFor(cap.pc);
  const node = nodeForCell(cap.m, cap.n);
  return {
    m: cap.m,
    n: cap.n,
    pc: cap.pc,
    points,
    code: node?.code,
    // Only the fundamental domain's twelve caps are labelled; the rest of the
    // block plays without a hint. DESIGN.md "Keyboard".
    key: node?.hint ? shortKey(node.code) : undefined,
    x: cap.x,
    y: -cap.y,
    name: equalTemperamentNameFor(ratio),
  };
});

// The lit layer: one path per pitch class, holding every hexagon of that pitch
// class in the drawn window. It paints the fill and it is the only thing that
// changes when a note sounds, so a press costs one class write however many
// caps are on screen — DESIGN.md "The lit layer". The caps below still own the
// stroke, the clip, the labels and the hit test.
const litPaths = capPaths().map((path) => ({
  ...path,
  hue: hueFor(equalTemperamentRatioFor(path.pc)),
}));

const viewBox = `${CX - EXTENT} ${-(CY + EXTENT)} ${EXTENT * 2} ${EXTENT * 2}`;

// The same hexagon again, as fractions of its own bounding box, so a cap can
// be clipped to itself and no effect on it can reach a neighbour — DESIGN.md
// "Effects stay inside the cap". Derived from HEX rather than hand-written:
// there is one hexagon in this repo and it is in tonnetz.ts. On this one the
// six vertices still land on exact fractions of the box (x at quarters,
// y at fifths, since the y offsets are now halves), so nothing here rounds.
const screenHex = HEX.map(([hx, hy]): [number, number] => [hx, -hy]);
const clipXs = screenHex.map(([x]) => x);
const clipYs = screenHex.map(([, y]) => y);
const [cx0, cx1] = [Math.min(...clipXs), Math.max(...clipXs)];
const [cy0, cy1] = [Math.min(...clipYs), Math.max(...clipYs)];
const capClip = `polygon(${screenHex
  .map(([x, y]) => `${((x - cx0) / (cx1 - cx0)) * 100}% ${((y - cy0) / (cy1 - cy0)) * 100}%`)
  .join(", ")})`;
---

<Layout
  title="Tonnetz Organ"
  description="A musical instrument based on the Tonnetz — a repeating layout where nearby notes sound nice together. Playable via touch, mouse, or keyboard."
>
  <header class="visually-hidden">
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <!-- The HUD: three square buttons on a top bar, info at one end and zoom
       at the other, all sharing one style — DESIGN.md "About panel" /
       "Zoom". Declared before .about-scrim so same-layer stacking puts the
       scrim on top of these while the About panel is open. -->
  <div class="hud" data-hud>
    <button
      type="button"
      class="hud-btn"
      data-about-toggle
      aria-label="About"
      aria-expanded="false"
      aria-controls="about-body"
    >
      &#9432;
    </button>
    <div class="zoom-controls" data-zoom-controls>
      <button type="button" class="hud-btn" data-zoom-out aria-label="Zoom out">&#8722;</button>
      <button type="button" class="hud-btn" data-zoom-in aria-label="Zoom in">&#43;</button>
    </div>
  </div>
  <div class="about-scrim" data-about-scrim aria-hidden="true"></div>
  <!-- A plain card, not a plate that grows into one: no always-visible title
       to morph from, so open/close is just a fade — DESIGN.md "About
       panel". -->
  <section class="about" data-about>
    <button type="button" class="about-close" data-about-close aria-label="Close">&#215;</button>
    <h1>Tonnetz Organ</h1>
    <div class="about-body" id="about-body">
      <p>
        A musical instrument based on the
        <a href="https://en.wikipedia.org/wiki/Tonnetz" target="_blank" rel="noopener noreferrer">Tonnetz</a>
        — a repeating layout where nearby notes sound nice together.
      </p>
      <p>
        There is no highest note — each note plays a
        <a href="https://en.wikipedia.org/wiki/Shepard_tone" target="_blank" rel="noopener noreferrer">Shepard tone</a>.
      </p>
      <p>Playable via touch, mouse, or keyboard.</p>
    </div>
  </section>
  <noscript>
    <p class="noscript-plate">Needs JavaScript to play.</p>
  </noscript>
  <main
    data-instrument
    class="stage"
    style={`--press-diameter:${R * 2}; --cap-clip:${capClip}; --fit-size:${FIT_SIZE_INITIAL}; --window-size:${WINDOW_SIZE}`}
  >
    <svg viewBox={viewBox} xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <g class="lit">
        {litPaths.map((path) => <path data-pc={path.pc} style={`--hue:${path.hue}`} d={path.d} />)}
      </g>
      <g class="caps">
        {
          renderCaps.map((cap) => (
            <g class="cap" data-m={cap.m} data-n={cap.n} data-pc={cap.pc} data-note={cap.code}>
              <polygon points={cap.points} />
              <text class="name" x={cap.x} y={cap.y}>
                {cap.name}
              </text>
              {cap.key && (
                <text class="key" x={cap.x + 0.9} y={cap.y + 0.9}>
                  {cap.key}
                </text>
              )}
            </g>
          ))
        }
      </g>
    </svg>
    <div class="cursor-dot" data-cursor aria-hidden="true"></div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>

<style>
  /* 1 twelfth = 100vmin/--fit-size: the short viewport axis always shows
     exactly FIT_SIZE twelfths (DESIGN.md "Sizing"), and vmin's continuous
     scaling reveals more of this same pre-drawn square on the long axis with
     no separate portrait case. The body (global.css) centres and clips the
     excess. */
  /* The HUD: three square buttons on a top bar, one style shared by all of
     them. z-index:1, same layer as .about-scrim and declared before it in
     the markup: same-layer siblings paint in DOM order, so the scrim (later)
     always paints on top of these and intercepts clicks on them while the
     About panel is open, closing the panel the same way clicking anywhere
     else on the scrim does — nothing extra to wire up for that.
     pointer-events:none on the wrapper, opted back in per-button, so the gap
     between the two clusters still reaches the surface underneath.

     Both custom properties live here, not on .hud-btn, since .hud's own
     insets and .zoom-controls' gap need --hud-gap too — descendants read
     both back by inheritance. --hud-btn-size is floored at 3rem = 48px:
     Apple HIG's minimum is 44pt, but Material Design's recommended minimum
     touch target is 48dp, and per instruction this is "a bit bigger" than
     the 44px floor it replaces. --hud-gap is a fixed fraction of the button
     size (8px : 44px, the original gap-to-button ratio between the zoom
     buttons and their old floor) rather than its own clamp, so the edge
     margin, the gap between the zoom buttons, and the button size all move
     together at every viewport width — never just at the clamp's own
     floor/ceiling — and per instruction are the same one number. */
  .hud {
    --hud-btn-size: clamp(3rem, 5vmin, 3.5rem);
    --hud-gap: calc(var(--hud-btn-size) * 0.182);
    position: fixed;
    top: var(--hud-gap);
    left: var(--hud-gap);
    right: var(--hud-gap);
    z-index: 1;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .hud-btn {
    width: var(--hud-btn-size);
    height: var(--hud-btn-size);
    display: grid;
    place-items: center;
    /* Scaled with the button (0.57 of its size, the original glyph-to-button
       ratio) so the icon keeps the same visual weight inside a bigger box. */
    font: 400 calc(var(--hud-btn-size) * 0.57) / 1 system-ui, sans-serif;
    color: oklch(96% 0.01 260);
    background: oklch(18% 0.01 260 / 0.72);
    border: 0;
    border-radius: 0.5rem;
    cursor: pointer;
    pointer-events: auto;
    transition: opacity 160ms ease-out;
  }

  /* Zoom in/out disable at their bounds (src/lib/zoom.ts); the info button
     never gets this attribute. */
  .hud-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* Order is out then in, left to right, per instruction. Keyboard tab order
     needs separate handling: src/lib/zoom.ts's setEnabled() pulls these two
     out of the tab order while the About panel is open, since a screen
     reader has no notion of "visually covered" by the scrim. */
  .zoom-controls {
    display: flex;
    gap: var(--hud-gap);
  }

  /* A plain card, not a plate that grows into one: there is no
     always-visible title to morph from any more, so open/close is just a
     fade — fixed geometry throughout, only opacity and visibility change.
     DESIGN.md "About panel". */
  .about {
    /* Two numbers describe the whole card: --card-pad is every distance to
       an edge, --card-gap is every distance between two things inside it.
       The × reads --card-pad for its own inset like everything else. */
    --card-w: min(34rem, 92vw);
    --card-pad: clamp(1.35rem, 4vmin, 2.4rem);
    --card-gap: clamp(0.8rem, 2.4vmin, 1.6rem);
    --close-size: clamp(2.75rem, 4.6vmin, 3.2rem);
    /* The × hugs the corner rather than sitting on --card-pad: it shares the
       title's row, and anything further in runs into the title's ink. */
    --close-inset: clamp(0.35rem, 1.6vmin, 1.05rem);
    --card-max: 78dvh;
    position: fixed;
    top: clamp(0.75rem, 6dvh, 4rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    width: var(--card-w);
    max-height: var(--card-max);
    padding: var(--card-pad);
    overflow: hidden auto;
    border-radius: 0.75rem;
    color: oklch(96% 0.01 260);
    /* Its own backdrop, because it has to stay legible over whichever cap
       happens to be under it, and the caps span a wide lightness range. The
       one part of the UI exempt from "no greys" — DESIGN.md "Visual design". */
    background: oklch(18% 0.01 260 / 0.94);
    opacity: 0;
    /* `visibility` is what keeps the ×, the heading and the body's links out
       of the tab order while closed — inherited, so nothing inside this
       panel needs its own visibility rule to get the same treatment. Same
       for pointer-events below: closed, nothing in here is clickable either. */
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 200ms ease-out,
      visibility 0s linear 200ms;
  }

  .about[data-open] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 200ms ease-out,
      visibility 0s;
  }

  .about h1 {
    margin: 0 0 var(--card-gap);
    font: 600 clamp(1.75rem, 5.4vmin, 2.8rem) / 1.2 system-ui, sans-serif;
    letter-spacing: 0.09em;
    white-space: nowrap;
    text-align: center;
  }

  /* Tall enough for the copy at the card's width, with a little slack. The
     narrow branch is for the card at 92vw, where the same copy takes half
     again as many lines; the body scrolls if it ever overflows, but at both
     marked viewports it does not. */
  @media (max-width: 34rem) {
    .about {
      --card-max: 82dvh;
    }
  }

  /* global.css's focus ring is black and inset, which is right on a cap and
     invisible on this panel. Same ring, this panel's palette. */
  .about :focus-visible {
    outline: 2px solid oklch(96% 0.01 260);
    outline-offset: 3px;
  }

  .about-close {
    position: absolute;
    top: var(--close-inset);
    right: var(--close-inset);
    display: grid;
    place-items: center;
    /* --close-size is floored at 2.75rem = 44px, the touch-target size, which
       the phone reads off the floor rather than off the vmin term. */
    width: var(--close-size);
    height: var(--close-size);
    font: 400 clamp(1.8rem, 3vmin, 2.1rem) / 1 system-ui, sans-serif;
    color: inherit;
    background: none;
    border: 0;
    border-radius: 0.4rem;
    cursor: pointer;
  }

  .about-body {
    font: 400 clamp(1.05rem, 2.6vmin, 1.5rem) / 1.55 system-ui, sans-serif;
    letter-spacing: normal;
    text-align: left;
    user-select: text;
    -webkit-user-select: text;
  }

  .about-body p {
    margin: 0 0 0.85em;
  }

  .about-body p:last-child {
    margin-bottom: 0;
  }

  /* global.css's link blue is a light-background colour; this one has to hold
     up on the panel's own dark backdrop. No underline: the colour alone
     distinguishes a link against this backdrop's short, link-sparse prose. */
  .about-body a {
    color: oklch(80% 0.13 240);
    text-decoration: none;
  }

  /* Under the panel, over the surface: a click anywhere off the card closes
     it, and while it is open nothing reaches the caps. */
  .about-scrim {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: rgb(0 0 0 / 0.55);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 320ms ease-out,
      visibility 0s linear 320ms;
  }

  .about-scrim[data-open] {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 320ms ease-out,
      visibility 0s;
  }

  /* Typed so --fit-size can be transitioned like any other animatable value
     — browsers can only tween a *known* type, never an opaque string
     (DESIGN.md "Zoom"). inherits:false: nothing ever reads --fit-size
     through inheritance — index.astro sets it as an inline style directly
     on .stage, the one place both the calc chain below and the JS in
     zoom.ts/Layout.astro read it back from — so there is no cascade for
     this property to opt into. */
  @property --fit-size {
    syntax: "<number>";
    inherits: false;
    initial-value: 15;
  }

  .stage {
    /* Driven by --fit-size (FIT_SIZE_INITIAL, tonnetz.ts) and --window-size
       (WINDOW_SIZE, tonnetz.ts) rather than hardcoded numbers, so those
       constants reach both the CSS here and Layout.astro's viewport
       correction, which reads --fit-size back off this element rather than
       restating it. DESIGN.md "Sizing". */
    --twelfth: calc(100vmin / var(--fit-size));
    position: relative;
    width: calc(var(--twelfth) * var(--window-size));
    height: calc(var(--twelfth) * var(--window-size));
    touch-action: none;
    /* Crosshair, per instruction: symmetrical, so it sits concentrically
       inside the press-radius ring instead of fighting it. */
    cursor: crosshair;
    /* Animates every zoom move (buttons, and the '0'/'-'/'=' keys — all of
       zoom.ts's moves are one ratio-step) for free through the
       --twelfth/width/height calc chain above — no JS tween needed. 240ms
       echoes this page's other transition durations (.hud-btn's opacity,
       160ms; main.ts's RESTRIKE flash, 220ms). */
    transition: --fit-size 240ms ease-out;
  }

  /* Placed after .stage, not before: with equal specificity a media query's
     `transition: none` only wins a cascade tie if it comes later in source
     order than the rule it's overriding. */
  @media (prefers-reduced-motion: reduce) {
    .about,
    .about[data-open],
    .about-scrim,
    .about-scrim[data-open],
    .hud-btn,
    .stage {
      transition: none;
    }
  }

  .stage svg {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  /* The lit layer: one path per pitch class, every hexagon of that pitch class
     in the drawn window as a disjoint subpath. It carries the fill and the
     state, so lighting a note is one class on one element whatever the zoom —
     DESIGN.md "The lit layer". pointer-events: none keeps it out of the way of
     the caps above, which are still what the browser hit-tests.

     Three states across a wide range, per instruction: the surface rests dark
     and dull and blooms as it is played. Lightness and chroma rise together,
     so a state differs in vividness as well as brightness — DESIGN.md
     "Visual design". Resting chroma stays high enough that hue still reads as
     pitch class; below about 0.06 the twelve stop being tellable apart. */
  .lit {
    pointer-events: none;
  }

  .lit path {
    fill: oklch(64% 0.07 var(--hue));
    transition: fill 500ms ease-out;
  }

  /* The mouse hover preview: which caps a click would press, DESIGN.md
     "Mouse preview". The same channel the played state uses, a smaller step
     along it — a preview is the played state's quieter cousin, not a
     different kind of mark. Declared before .active, which has equal
     specificity, so a pitch class that is both (a held key under a hovering
     mouse) reads as played. */
  .lit path.hover {
    fill: oklch(76% 0.115 var(--hue));
    transition-duration: 200ms;
  }

  .lit path.active {
    fill: oklch(89% 0.175 var(--hue));
    transition-duration: 15ms;
  }

  /* The caps paint no fill any more — the layer above does — but they still
     own the black edge, the clip, the labels and the hit test.

     Every cap is clipped to its own hexagon, so nothing drawn on one can reach
     a neighbour and make the paint order visible — DESIGN.md "Effects stay
     inside the cap". A centred stroke would spill half onto the neighbour
     without it, and the clip is load-bearing for the *pointer* as well as the
     paint: it is what makes a cap stop answering elementFromPoint at its
     hexagon rather than at the stroke's outer edge (scripts/check-cap-clip.js
     measures exactly that).

     `fill-box` is not optional. The default reference box for an SVG element
     is `border-box`, which css-masking maps to *stroke*-box, giving a clip
     that sits on the stroke's outer edge and widens with `stroke-width` — it
     parses, changes nothing, and hides that it changes nothing.

     Two placements this must keep: on the `polygon`, never on `.cap` (a <g>'s
     bounding box is the union of its children, labels included, so the
     fractions above would no longer describe the hexagon); and any future
     filter goes here too, since clipping is applied after filtering only for
     the same element.

     `pointer-events: all` is what `fill: none` costs: the default
     `visiblePainted` hit-tests the fill only where there is fill to paint, so
     without this every cap would stop answering and the surface would go
     dead. */
  .cap polygon {
    fill: none;
    stroke: #000;
    stroke-width: 0.09;
    clip-path: var(--cap-clip) fill-box;
    pointer-events: all;
  }

  /* The fat-finger hitbox, drawn for the one input that has no size of its
     own to show it with: a mouse pointer. Diameter is 2r in twelfths
     (--press-diameter, set from tonnetz.ts's R in index.astro) at the same
     px-per-twelfth scale as the caps, so the dot is the true footprint of a
     click, not a decoration sized to taste.

     It rides *around* the real cursor and never replaces it: the page must
     never take the pointer away, so no `cursor: none` anywhere — DESIGN.md
     "The page never owns the cursor". */
  .cursor-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(var(--twelfth) * var(--press-diameter));
    height: calc(var(--twelfth) * var(--press-diameter));
    margin: calc(var(--twelfth) * var(--press-diameter) / -2) 0 0 calc(var(--twelfth) * var(--press-diameter) / -2);
    border-radius: 50%;
    border: 1.5px solid oklch(100% 0 0 / 0.7);
    background: oklch(100% 0 0 / 0.15);
    pointer-events: none;
    opacity: 0;
    transition: opacity 120ms ease-out;
  }

  .cursor-dot.visible {
    opacity: 1;
  }

  .cap .name,
  .cap .key {
    fill: #000;
    text-anchor: middle;
    dominant-baseline: central;
    text-transform: uppercase;
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .cap .name {
    font: 700 1.15px system-ui, sans-serif;
  }

  /* Quieter than the pitch name by size and weight alone: both labels are
     plain black, per instruction, so nothing here reduces opacity to make the
     hint recede — that would composite the cap's hue through it and put a grey
     back on the surface. */
  .cap .key {
    font: 600 0.55px system-ui, sans-serif;
  }

  /* A hint names a key, and on a device with no keyboard it names nothing the
     player can reach. `any-hover` asks about input hardware rather than about
     layout, so a desktop window resized to phone proportions still has its
     mouse and keeps the hints; a phone that turns out to have a keyboard says
     so by using one, which main.ts is watching for. Losing them costs a phone
     nothing it can act on, and the About panel still says the instrument is
     playable by keyboard. */
  @media (any-hover: none) {
    :global(html:not(.has-keyboard)) .cap .key {
      display: none;
    }
  }

  /* Only exists at all with scripting off — the state where the lattice lays
     out perfectly and then does nothing, by far the most convincing way this
     page can look correct and be broken. Its own small plate rather than
     reusing `.about`: that element only ever appears once script has run to
     open it, and with scripting off nothing ever will. Top inset matches the
     HUD buttons' own — nothing else sits above this any more, so there is no
     other plate's height left to clear. */
  .noscript-plate {
    position: fixed;
    top: clamp(0.75rem, 3vmin, 1.5rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    /* Without this the box shrink-wraps against the space left of `left: 50%`
       — half the viewport — and the line wraps on a phone for no reason. */
    width: max-content;
    max-width: 92vw;
    margin: 0;
    padding: 0.3rem 1.1rem 0.4rem;
    color: oklch(96% 0.01 260);
    font: 600 clamp(0.9rem, 2.2vmin, 1.1rem) / 1.2 system-ui, sans-serif;
    letter-spacing: 0.06em;
    text-align: center;
    /* The plate's backdrop, for the plate's reason: it has to stay legible
       over whichever cap happens to be under it. */
    background: oklch(18% 0.01 260 / 0.72);
    border-radius: 0.5rem;
    /* Nothing to click, and the surface keeps the pointer. */
    pointer-events: none;
  }

</style>
